@import "tailwindcss";
@import "tw-animate-css";

@theme {
  --color-paper: #faf7f3;
  --color-ink: #16131f;
  --color-mute: #6f6a7a;
  --color-line: #e9e3dc;
  --color-coral: #f58a63;
  --color-violet: #2F7BF6;
  --font-sans: "Inter", ui-sans-serif, system-ui, sans-serif;
}

body { background: #faf7f3; color: #16131f; font-family: var(--font-sans); }
.grad-text { background: linear-gradient(90deg,#f58a63,#7c5cf0); -webkit-background-clip: text; color: transparent; }
.glow { position: fixed; inset: auto 0 0 0; height: 220px; z-index: 0; pointer-events: none;
  background: linear-gradient(90deg,#fbd3c2,#d9ccff); filter: blur(70px); opacity: .65; }

@layer components {
  .card { @apply rounded-3xl border border-line bg-white/70 p-6 backdrop-blur sm:p-8; }
  .btn-dark { @apply inline-flex min-h-12 items-center justify-center gap-2 rounded-full bg-ink px-6 text-sm font-semibold text-white transition hover:bg-black active:scale-[.98] disabled:opacity-50; }
  .btn-light { @apply inline-flex min-h-12 items-center justify-center gap-2 rounded-full border border-line bg-white px-6 text-sm font-medium text-ink transition hover:bg-paper active:scale-[.98] disabled:opacity-50; }
  .input { @apply w-full rounded-xl border border-line bg-white px-4 py-3 text-sm outline-none focus:border-violet; }
}

@keyframes chip-pop {
  0%   { transform: scale(.85); opacity: .4; }
  60%  { transform: scale(1.06); opacity: 1; }
  100% { transform: scale(1); }
}
@media (prefers-reduced-motion: reduce) {
  [style*="chip-pop"] { animation: none !important; }
}

.grad-text {
  background-image: linear-gradient(90deg, #2f7bf6 0%, #19c3a5 100%);
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
  color: transparent;
  padding-block: 0.12em; /* stops tall Indic marks being clipped */
}
 
.glow {
  position: fixed;
  inset: 0;
  z-index: 0;
  pointer-events: none;
  background:
    radial-gradient(38rem 30rem at -8% -6%,   rgba(111, 168, 255, .42), transparent 62%),
    radial-gradient(34rem 28rem at -6% 104%,  rgba(255, 159, 85, .34),  transparent 62%),
    radial-gradient(30rem 26rem at 104% 30%,  rgba(245, 194, 61, .30),  transparent 62%),
    radial-gradient(34rem 28rem at 108% 108%, rgba(25, 195, 165, .34),  transparent 62%);
}